# 将本文件复制为 .env，然后填写本机实际值。绝对不要提交 .env。
# API 密钥只从系统环境变量或 .env 读取，不要写入 config.yaml。

# ---- 跨电脑便携路径（推荐配置） ----
# FOHE_LIBRARY_ROOT：最终素材根目录，保存 clips、thumbnails、clean；请放在非系统盘并备份。
# FOHE_DATABASE_PATH：SQLite 素材索引；相对路径会随项目目录移动，需要与素材一起备份。
# FOHE_CACHE_ROOT：下载、抽帧和处理中间文件；程序停止后可删除并重新生成。
# FOHE_FFMPEG_PATH：FFmpeg 可执行文件，用于真实剪片、转码和缩略图生成。
# FOHE_FFPROBE_PATH：FFprobe 可执行文件，用于读取时长、分辨率和编码信息。
# 下方 FFmpeg 默认值指向项目内的 Conda 环境，因此项目更换盘符后仍能使用。
# 配置优先级：程序显式参数 > 系统环境变量 > .env > config.yaml。
# 正式运行时以上五项都建议保留；若 FFmpeg/FFprobe 已加入 PATH，可将对应值留空。
FOHE_LIBRARY_ROOT=D:/素材库2
FOHE_DATABASE_PATH=./data/library.db
FOHE_CACHE_ROOT=./cache
FOHE_FFMPEG_PATH=./.venv/Library/bin/ffmpeg.exe
FOHE_FFPROBE_PATH=./.venv/Library/bin/ffprobe.exe

# ---- Qwen / DashScope 视觉分析 ----
# 用于视频预筛、有效片段识别和结构化标签生成。
# QWEN_API_KEY：使用 Qwen 作为视觉模型时必填，属于敏感密钥。
# QWEN_BASE_URL：兼容 OpenAI 协议的 DashScope 服务地址；仅在账号或地域变化时修改。
# QWEN_VISION_MODEL：实际调用的多模态模型名称；未单独指定时，所有 Qwen 任务都使用它。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-flash-2026-01-22

# ---- 火山方舟视觉模型（可选备用 AI） ----
# 本部分与后面的 VOD 去字幕不是同一服务，只在选择方舟作为视觉分析模型或备用模型时使用。
# VOLCANO_API_KEY：方舟模型 API 密钥；只使用 Qwen 时可以留空。
# VOLCANO_BASE_URL：方舟兼容 OpenAI 协议的接口地址。
# VOLCANO_VISION_MODEL：方舟接入点或模型标识；启用方舟时必填。
VOLCANO_API_KEY=
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCANO_VISION_MODEL=

# ---- 抖音网页直连适配器（可选） ----
# DOUYIN_COOKIE：适配器直接请求抖音网页接口时使用的 Cookie，不是下面的后端登录 Cookie。
# DOUYIN_USER_AGENT：与该 Cookie 对应的浏览器 User-Agent。
# 使用本地 DTK 后端或持久化浏览器会话发现视频时，这两项可以留空。
DOUYIN_COOKIE=
DOUYIN_USER_AGENT=

# ---- 日志 ----
# LOG_LEVEL：控制控制台和日志文件的详细程度，可选 DEBUG、INFO、WARNING、ERROR。
# 正常运行建议使用 INFO；排查问题时临时改为 DEBUG。程序不应在任何级别输出密钥。
LOG_LEVEL=INFO

# ---- 本地 DTK / 抖音下载后端鉴权 ----
# DOUYIN_BACKEND_SESSION_COOKIE：本 Agent 登录本地下载后端控制台时使用的会话 Cookie。
# 它不是 douyin.com Cookie；仅当后端启用控制台/会话鉴权时需要。
# 应从已经登录的后端会话导出，禁止提交、截图或打印其值。
DOUYIN_BACKEND_SESSION_COOKIE=

# ---- DashScope 字幕/视觉辅助接口 ----
# DASHSCOPE_API_KEY：旧版或专项字幕分析集成使用的凭据；可能与 Qwen 密钥属于同一账号，
# 但仍独立配置，便于分别替换和停用。
# DASHSCOPE_BASE_URL：该集成使用的 DashScope 原生接口地址。
# 本部分不会启用火山 VOD 付费去字幕。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ---- 火山引擎 VOD 去字幕（付费功能） ----
# 本组配置用于视频上传、创建任务、轮询状态和鉴权下载。
# 只有本地零费用前置检测通过且显式启动云去字幕时才会产生付费调用；
# 单次和每日付费上限在 config.yaml 中配置。
# VOLCENGINE_ACCESS_KEY_ID：具有 VOD 权限的 IAM Access Key ID，属于敏感凭据。
# VOLCENGINE_SECRET_ACCESS_KEY：与 Access Key ID 配套的 Secret，属于敏感凭据。
# LAS_API_KEY：旧版 LAS/operator 路径使用；当前精细去字幕主要使用上面的 IAM 密钥对。
# VOLCENGINE_REGION：VOD 空间所在地域，例如 cn-north-1 或 cn-beijing。
# VOLCENGINE_ENDPOINT：可选的 LAS/operator 地址，不是 VOD 公共 API 地址。
# VOLCENGINE_VOD_SPACE_NAME：保存输入视频和处理产物的 VOD 空间名称。
# VOLCENGINE_VOD_STORAGE_DOMAIN：生成产物下载地址时使用的播放/存储域名。
# VOLCENGINE_VOD_URL_AUTH_KEY：生成临时 Type-A 鉴权下载地址的签名密钥。
# 临时签名 URL 的查询参数本身具有访问权限，禁止写入数据库、日志或提交到 Git。
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
LAS_API_KEY=
VOLCENGINE_REGION=cn-beijing
VOLCENGINE_ENDPOINT=
VOLCENGINE_VOD_SPACE_NAME=
VOLCENGINE_VOD_STORAGE_DOMAIN=
VOLCENGINE_VOD_URL_AUTH_KEY=

# ---- 火山引擎 TOS 对象存储（可选） ----
# TOS_BUCKET：仅供通过 TOS 中转文件的流程使用。
# 当前 VOD 直接上传/下载流程不依赖它，除非部署时明确启用了 TOS 暂存。
# 地域和凭据复用上方火山配置，或由具体部署单独提供。
TOS_BUCKET=
